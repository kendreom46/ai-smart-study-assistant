# ==============================================================================
# StudyMate AI - Environment Configuration
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and provide your personal Gemini API key.
# Never commit your '.env' file or API keys to GitHub!
# ==============================================================================

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name
# Recommended defaults: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Local SQLite Database Path (created automatically at runtime)
DATABASE_PATH=data/studymate.db
